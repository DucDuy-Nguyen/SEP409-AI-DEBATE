# Copy thanh .azure-db.env (KHONG commit) roi dien gia tri. Dung boi: .\run-all.ps1 -Azure
SYSTEM_SQL_CONNECTION=Server=tcp:adpp-sql-in066.database.windows.net,1433;Initial Catalog=DebatePracticePlatformDB;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30
OPPONENT_DATABASE_URL=postgresql+asyncpg://<user>:<password>@adpp-postgres-dev066.postgres.database.azure.com:5432/ai_generation?ssl=require
# Tuy chon (ca .\run-all.ps1 lan .\run-all.ps1 -Azure): TURN mien phi cua Cloudflare Realtime cho goi dong doi 2v2.
# Dashboard -> Realtime -> TURN Server -> tao key. Bo trong = chi dung STUN.
TEAMCALL_TURN_KEY_ID=
TEAMCALL_TURN_API_TOKEN=
# Tuy chon: bat RAG cho evaluator local, dung kho fact tren Azure
RAG_DATABASE_URL=postgresql://<user>:<password>@adpp-postgres-dev066.postgres.database.azure.com:5432/ai_evaluation?sslmode=require
