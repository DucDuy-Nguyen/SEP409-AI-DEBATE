# Copy file nay thanh ".env" va dien API key that vao, KHONG commit file .env len git.

# --- Database (PostgreSQL trong docker-compose.yml, port host 5433) ---
DATABASE_URL=postgresql+asyncpg://adpp:adpp@localhost:5433/ai_generation
# DB rieng cho pytest (cung container, tao san boi docker/postgres-init)
TEST_DATABASE_URL=postgresql+asyncpg://adpp:adpp@localhost:5433/ai_generation_test
DB_ECHO=false

# --- LLM provider: "openai", "anthropic", "gemini", hoac "groq" ---
# Groq mac dinh: free tier khong can the (giong AI Evaluation service).
LLM_PROVIDER=groq

# --- Groq --- lay key tai https://console.groq.com/keys
GROQ_API_KEY=
# llama-3.3-70b-versatile da bi Groq khai tu (xem dev log Evaluation service muc 3.1)
GROQ_MODEL=openai/gpt-oss-120b

# --- Gemini --- lay key tai https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Tinh chinh chung ---
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=60
# Loi mang / timeout / 5xx thoang qua: thu lai toi da N lan, cho W x 2^(lan-1) giay (Case Planning + luot noi).
LLM_TRANSIENT_RETRIES=2
LLM_TRANSIENT_RETRY_WAIT_SECONDS=2.0

# --- Case Planning ---
# Prompt dang dung: case_plan_v5 (mac dinh), case_plan_v4 / case_plan_v3 (giu de so sanh). Dung chung CaseFile + validator.
# case_plan_v6 (thi nghiem motion_type, muc 2.13): chi dung khi session co motion_type + motion_reading, thieu -> v5.
# case_plan_v6b (ganh nang chung minh, muc 2.15): chi dung khi session co motion_type + burden_pro + burden_con, thieu -> v5.
# case_plan_v7 (= v5 + khoi ganh nang, muc 2.16): chi dung khi session co burden_pro + burden_con (khong can motion_type).
# MAC DINH case_plan_v7 (muc 2.17): session co burden_pro + burden_con -> v7; khong co burden -> tu dung v5.
CASE_PLAN_PROMPT_VERSION=case_plan_v7
CASE_PLAN_TEMPERATURE=0.7
CASE_PLAN_MAX_TOKENS=4000
# So lan thu khi LLM tra output khong hop le (sai JSON / schema / so luan diem / example khong bat dau
# bang "Gia su" / cum bi cam / Groq tu choi vi sai JSON schema / reviewer bao lat phe). Moi lan retry gui
# kem phan hoi neu ro truong nao sai gi (luu o opponent_llm_calls.retry_feedback).
# 3 tu 2026-09-29 (truoc la 2). Groq tu choi schema vi go sai ten truong (<= 3 ky tu) duoc TU SUA, khong ton luot.
CASE_PLAN_MAX_ATTEMPTS=3
# Gui JSON schema (structured output strict) — hien chi Groq dung. Dat false neu model khong ho tro.
CASE_PLAN_USE_JSON_SCHEMA=true
# Loi 429: so lan thu lai + thoi gian cho moi lan (SDK da tat retry ngam, service tu retry va log)
CASE_PLAN_RATE_LIMIT_RETRIES=4
# Cho theo retry-after / "try again in Xs" cua provider + jitter 1-2s; gia tri duoi CHI dung khi provider
# khong noi phai cho bao lau. Lan cho 429 KHONG tinh vao CASE_PLAN_MAX_ATTEMPTS.
CASE_PLAN_RATE_LIMIT_WAIT_SECONDS=3
# Tran thoi gian cho TOAN BO Case Planning (moi lan thu + moi lan cho 429). Het -> 504, phien FAILED.
CASE_PLAN_TOTAL_BUDGET_SECONDS=240
# Phien PLANNING lau hon nguong nay bi coi la "ket" va duoc chay lai (chua qua -> 409).
# BAT BUOC > CASE_PLAN_TOTAL_BUDGET_SECONDS + 60, neu khong service tu choi khoi dong.
CASE_PLAN_STALE_AFTER_SECONDS=360

# --- Stance Reviewer (trong tai trung lap kiem tra case file co bao ve DUNG phe khong) ---
# Provider/model RIENG, doc lap voi LLM_PROVIDER. Temperature co dinh 0 trong code.
# Ton them ~1 lan goi LLM (~2s) moi lan thu Case Planning; nam trong CASE_PLAN_TOTAL_BUDGET_SECONDS.
STANCE_REVIEW_ENABLED=true
STANCE_REVIEW_PROVIDER=groq
STANCE_REVIEW_MODEL=openai/gpt-oss-20b
# 2000: reviewer v1 dung toi da ~1217 token (batch v4); v2 tung bi CAT o 1500; v3 viet them restatement.
STANCE_REVIEW_MAX_TOKENS=2000
# stance_review_v1 (mac dinh tu 2026-09-29, muc 2.4m): chi claim. v3 bao sai 3/3 side_flip o batch v5.
# v2: claim + reasoning. v3: dien dat lai roi hoi "kien nghi manh hon hay yeu di?". So sanh: scripts/replay_stance_review.py.
STANCE_REVIEW_PROMPT_VERSION=stance_review_v1

# Muc suy luan gui Groq cho planner (gpt-oss: low / medium / high). Mac dinh medium (gui tuong minh, muc 2.11).
CASE_PLAN_REASONING_EFFORT=medium

# --- Luot tranh luan (Giai doan 3) ---
# Bo sinh bai noi cua AI. turn_full_v6 (mac dinh, muc 2.19) = v5 + sua loi chep tien de (premises_reused),
# "tôi" -> "mình", bo "cố định" o rang buoc cuoi, kiem tra so bo qua "thế kỷ 21" / so thu tu.
# turn_full_v5 (muc 2.18) = v4 + sua loi tu 4 tran thu 30/09.
# turn_full_v4 (muc 2.17) = v3 + ganh nang chung minh cua phe AI khi session co burden.
# turn_full_v3 = v2 + "khong nhac lai / dien giai quy tac, chi dan".
# turn_full_v2 = turn_full_v1 + "khong doc thuat ngu phan tich".
# turn_full_v1: case file + ledger + JSON (phan tich -> dan y -> bai noi) + validator.
# turn_baseline_v1: chatbot ngay tho, KHONG dung case file (moc so sanh, giu nguyen hanh vi 3a).
TURN_GENERATOR_VERSION=turn_full_v7
# false = turn_full_v4 / v5 / v6 KHONG dua burden vao prompt (ablation); generator_version ghi turn_full_v*_noburden.
TURN_BURDEN_ENABLED=true
# false = turn_full_v7 co prompt + schema giong het v6, khong validator target; generator_version ghi
# turn_full_v7_nodifficulty[_noburden]. Khong anh huong v1..v6.
TURN_DIFFICULTY_ENABLED=true
TURN_TEMPERATURE=0.5
# CHI turn_full_v* (baseline co dinh 3000 token / 2 lan thu nhu 3a). Gom ca token suy luan cua gpt-oss.
TURN_MAX_TOKENS=6000
# Muc suy luan cho loi goi sinh bai noi (low / medium / high). Mac dinh medium: tran low lat phe ca tran (muc 2.11).
TURN_REASONING_EFFORT=medium
# Thu lai khi output khong hop le (JSON / schema / bi cat / bang chung HIGH), co phan hoi. Do dai la loi MEM: toi da 1 lan
# thu lai roi chap nhan ban gan nhat. 429 dung chung CASE_PLAN_RATE_LIMIT_RETRIES / _WAIT_SECONDS, khong tinh vao day.
TURN_MAX_ATTEMPTS=3
# Tran thoi gian 1 luot (moi lan goi + moi lan cho 429 / loi mang). Cho 429 KHONG gioi han so vong, chi bi chan o day.
TURN_TOTAL_BUDGET_SECONDS=240
# Do dai muc tieu (so tu). turn_full_v*: prompt yeu cau [0.8, 1.2] x muc tieu, chap nhan [0.7, 1.25]; baseline chi dua vao prompt.
TURN_TARGET_WORDS_OPENING=400
TURN_TARGET_WORDS_REBUTTAL=320
TURN_TARGET_WORDS_CLOSING=260

# --- Goi y phan bac cho learner (WF-02, POST .../hints) ---
# Temperature dung LLM_TEMPERATURE. 2000 (spec goi y 700): gpt-oss tinh ca token suy luan vao max_tokens.
HINT_MAX_TOKENS=2000
HINT_REASONING_EFFORT=low
# So lan thu khi goi y khong hop le (JSON / validator / lat phe / reviewer loi); het -> 502.
HINT_MAX_ATTEMPTS=3
# Tran thoi gian 1 request hint (moi lan goi + cho 429). Het -> 502.
HINT_TOTAL_BUDGET_SECONDS=90

# --- App ---
APP_PORT=8002
