# Copy file nay thanh ".env" va dien API key that vao, KHONG commit file .env len git.

# Chon "openai", "anthropic", "gemini", hoac "groq"
# Dang de "groq" lam default — free tier khong can the, toc do rat nhanh (LPU rieng),
# dung de test truoc khi chot ngan sach cho OpenAI/Anthropic.
LLM_PROVIDER=groq

# --- Neu dung Groq (free tier, khong can card) ---
# Lay key tai: https://console.groq.com/keys
GROQ_API_KEY=
# LUU Y: danh sach model free cua Groq thay doi thuong xuyen (llama-3.3-70b-versatile
# da bi khai tu). Neu loi "model not found", liet ke model con active bang:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer <GROQ_API_KEY>"
# roi sua lai dong duoi.
GROQ_MODEL=openai/gpt-oss-120b

# --- Neu dung Gemini (free tier, khong can card) ---
# Lay key tai: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Neu dung OpenAI ---
OPENAI_API_KEY=
# gpt-4o-mini: re nhat ($0.15/$0.60 per 1M token), du dung cho capstone
# gpt-5.4-mini: moi hon, manh hon, dat hon ~5x ($0.75/$4.50 per 1M token)
OPENAI_MODEL=gpt-4o-mini

# --- Neu dung Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Tinh chinh chung ---
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=60
