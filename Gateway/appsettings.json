{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "system-auth-route": {
        "ClusterId": "system-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "system-users-route": {
        "ClusterId": "system-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "system-admin-route": {
        "ClusterId": "system-cluster",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "system-cluster": {
        "Destinations": {
          "system-service": {
            "Address": "http://localhost:5001/"
          }
        }
      }
    }
  }
}
