{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning"
                                 }
                },
    "AllowedHosts":  "*",
    "ReverseProxy":  {
                         "Routes":  {
                                        "system-auth-route":  {
                                                                  "ClusterId":  "system-cluster",
                                                                  "Match":  {
                                                                                "Path":  "/api/auth/{**catch-all}"
                                                                            }
                                                              },
                                        "system-users-route":  {
                                                                   "ClusterId":  "system-cluster",
                                                                   "Match":  {
                                                                                 "Path":  "/api/users/{**catch-all}"
                                                                             }
                                                               },
                                        "system-admin-route":  {
                                                                   "ClusterId":  "system-cluster",
                                                                   "Match":  {
                                                                                 "Path":  "/api/admin/{**catch-all}"
                                                                             }
                                                               },
                                        "system-competitions-route":  {
                                                                          "ClusterId":  "system-cluster",
                                                                          "Match":  {
                                                                                        "Path":  "/api/competitions/{**catch-all}"
                                                                                    }
                                                                      },
                                        "ai-opponent-route":  {
                                                                  "ClusterId":  "ai-opponent-cluster",
                                                                  "Match":  {
                                                                                "Path":  "/api/opponent/{**catch-all}"
                                                                            },
                                                                  "Transforms":  [
                                                                                     {
                                                                                         "PathRemovePrefix":  "/api"
                                                                                     }
                                                                                 ]
                                                              },
                                        "ai-evaluator-route":  {
                                                                   "ClusterId":  "ai-evaluator-cluster",
                                                                   "Match":  {
                                                                                 "Path":  "/api/evaluate/{**catch-all}"
                                                                             },
                                                                   "Transforms":  [
                                                                                      {
                                                                                          "PathRemovePrefix":  "/api"
                                                                                      }
                                                                                  ]
                                                               }
                                    },
                         "Clusters":  {
                                          "system-cluster":  {
                                                                 "Destinations":  {
                                                                                      "system-service":  {
                                                                                                             "Address":  "http://localhost:5001/"
                                                                                                         }
                                                                                  }
                                                             },
                                          "ai-opponent-cluster":  {
                                                                      "HttpRequest":  {
                                                                                          "ActivityTimeout":  "00:02:00"
                                                                                      },
                                                                      "Destinations":  {
                                                                                           "opponent-service":  {
                                                                                                                    "Address":  "http://localhost:8002/"
                                                                                                                }
                                                                                       }
                                                                  },
                                          "ai-evaluator-cluster":  {
                                                                       "HttpRequest":  {
                                                                                           "ActivityTimeout":  "00:02:00"
                                                                                       },
                                                                       "Destinations":  {
                                                                                            "evaluator-service":  {
                                                                                                                      "Address":  "http://localhost:8000/"
                                                                                                                  }
                                                                                        }
                                                                   }
                                      }
                     }
}
