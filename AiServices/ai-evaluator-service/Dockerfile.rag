# AI Evaluator CO RAG (bge-m3 + pgvector). Dockerfile cu (khong RAG) giu nguyen cho Azure Container Apps.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models

WORKDIR /app

# torch ban CPU truoc (nho hon nhieu ban CUDA), roi phan con lai; torch da thoa nen khong bi cai lai
COPY requirements.txt requirements-rag.txt ./
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch \
 && pip install -r requirements-rag.txt

COPY app ./app

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
