# AI Evaluator CO RAG (bge-m3 + pgvector). Dung cho Azure Container Apps (tag v2-rag) va docker-compose.prod.yml.
# Dockerfile cu (khong RAG, tag v1) giu nguyen de rollback.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models

WORKDIR /app

# torch ban CPU truoc (nho hon nhieu ban CUDA), roi phan con lai; torch da thoa nen khong bi cai lai
COPY requirements.txt requirements-rag.txt ./
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch \
 && pip install -r requirements-rag.txt

# Tai san bge-m3 (~2,3 GB) vao image: container khong phai tai lai moi lan khoi dong (scale tu 0).
# app/rag/embedder.py doc model tu /app/.hf_cache (gan cung), nen tai vao dung thu muc do, khong phai HF_HOME.
# Chi tai trong so PyTorch (repo con co ban ONNX 2,2 GB va colbert/sparse, app khong dung),
# roi nap thu o che do offline ngay luc build: thieu file nao thi build loi o day, khong loi luc chay.
RUN python -c "from huggingface_hub import snapshot_download; snapshot_download('BAAI/bge-m3', cache_dir='/app/.hf_cache', allow_patterns=['*.json', '*.model', 'pytorch_model.bin', '1_Pooling/*'])" \
 && HF_HUB_OFFLINE=1 python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-m3', device='cpu', cache_folder='/app/.hf_cache').encode(['ok'])"
# Model da co trong image: khong goi Hugging Face luc chay (khoi dong nhanh hon, khong phu thuoc mang/rate limit)
ENV HF_HUB_OFFLINE=1

COPY app ./app

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
