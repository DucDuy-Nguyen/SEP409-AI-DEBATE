# Mau .env cho docker-compose.prod.yml tren VM. Chep thanh .env, dien gia tri, chmod 600 .env.
# KHONG commit .env that.

# LLM (cham diem + tach claim + kiem chung dung chung)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
LLM_TIMEOUT_SECONDS=

# Provider du phong (tuy chon)
GEMINI_API_KEY=
GEMINI_MODEL=

# Mat khau Postgres noi bo (chi chu + so, >= 32 ky tu). Compose tu ghep RAG_DATABASE_URL tu bien nay.
POSTGRES_PASSWORD=

# Tuy chon: audit log raw output (mac dinh logs/eval_audit.jsonl, mount ra ./logs); de trong = tat
# EVAL_AUDIT_LOG_PATH=
